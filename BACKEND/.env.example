# ==========================================
# IAI TOGO - Fichier d'environnement exemple
# ==========================================
# Copiez ce fichier en .env et remplissez les valeurs

# ==========================================
# Configuration Django
# ==========================================
SECRET_KEY=votre-cle-secrete-django-ici
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# Base de données (PostgreSQL)
# ==========================================
# Laissez vide pour utiliser SQLite par défaut
DB_NAME=iai_db
DB_USER=postgres
DB_PASSWORD=votre-mot-de-passe
DB_HOST=localhost
DB_PORT=5432

# ==========================================
# Configuration Email (SMTP Gmail)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-app-gmail
DEFAULT_FROM_EMAIL=IAI Togo <votre-email@gmail.com>

# ==========================================
# Instructions pour Gmail
# ==========================================
# 1. Activez la validation en 2 étapes sur votre compte Gmail
# 2. Générez un mot de passe d'application :
#    https://myaccount.google.com/apppasswords
# 3. Utilisez ce mot de passe d'application dans EMAIL_HOST_PASSWORD

# ==========================================
# Configuration IA (OpenRouter)
# ==========================================
# Clé API pour l'assistant IA
OPENROUTER_API_KEY=votre-cle-api-openrouter-ici
# Modèle IA à utiliser (par défaut: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini
